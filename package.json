{
  "name": "flowstudio-next-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "next build",
    "test:protected-routes": "next build && node scripts/check-protected-routes.mjs",
    "local:setup": "node scripts/local-setup.mjs",
    "local:start": "node scripts/local-start.mjs",
    "test:local": "node scripts/local-smoke.mjs",
    "test": "node --test server/src/security/*.test.js server/src/jobs/*.test.js server/src/services/*.test.js lib/*.test.mjs"
  },
  "dependencies": {
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.4"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
