# Copy to server/.env for an independently configured deployment. Never commit .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
APP_ORIGINS=https://studio.example.invalid
API_PUBLIC_BASE_URL=https://api.example.invalid
STORE_DRIVER=postgres
DATABASE_URL=
DATA_DIR=./data
SESSION_SECRET=
API_KEY_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
STORAGE_PROVIDER=local
# Absolute path to your private provider definitions. Default: no enabled channels.
WORKFLOW_PROVIDER_CONFIG=
PROVIDER_ADAPTER_TIMEOUT_MS=120000
